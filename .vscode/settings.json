{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.analysis.extraPaths": ["${workspaceFolder}/backend"],
  "css.lint.unknownAtRules": "ignore",
  "files.exclude": {
    "**/.venv": true,
    "**/venv": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/node_modules": true,
    "frontend/dist": true,
    "backend/staticfiles": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/venv": true,
    "**/node_modules": true,
    "frontend/dist": true,
    "backend/staticfiles": true
  }
}
